# Copy this file to .env and fill in your own values.

# WhatsApp, then API Setup, in your app at https://developers.facebook.com
META_TOKEN=
META_PHONE_NUMBER_ID=

# Any text you choose. Type the same text into the Meta webhook page.
META_VERIFY_TOKEN=visitor-access-verify

# App settings, then Basic. Required: the app does not start without it.
META_APP_SECRET=
# Only for a test on your own machine: true lets the app start without
# META_APP_SECRET, and then it accepts unsigned webhook calls. Never in production.
ALLOW_UNSIGNED_WEBHOOK=

# Approver numbers in E.164 form: plus sign, country code, number.
# Each one must also be on the recipient list in the API Setup page.
MAIN_APPROVER=+910000000000
BACKUP_APPROVER=+910000000000
# Gate desk number. Defaults to the main approver. Gets the gate key on request.
GUARD=+910000000000
# Gets the admin key on request. Defaults to the main approver.
ADMIN_PHONE=

# Each reason on the form has its own main and backup approver. A reason not
# named here uses MAIN_APPROVER and BACKUP_APPROVER. The reasons are:
# See a student, See an office, Delivery, Event, Other. A reason the visitor
# types in counts as Other. Leave it unset to send every reason to the two above.
# APPROVERS={"Delivery": ["+910000000001", "+910000000002"]}
APPROVERS=

# Password for the gate page: 20 characters or more, random. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# The app does not start with a shorter key.
GATE_KEY=
# Password for the admin page at /admin, made the same way. It must differ from
# GATE_KEY, because every guard holds the gate key. Without a good one, the
# admin page stays locked and the rest of the app runs.
ADMIN_KEY=

GATE_DESK_PHONE=+910000000000
# Minutes with no answer before the backup approver is asked.
ESCALATE_MINUTES=15
# Auto-approve a request made in working hours after this many minutes. 0 = off.
AUTO_APPROVE_MINUTES=30
WORK_HOURS=10-17
WORK_DAYS=Mon,Tue,Wed,Thu,Fri,Sat
WORK_TIMEZONE=Asia/Kolkata

# The approved WhatsApp template for the approval request. WhatsApp drops plain
# text to anyone who has not messaged this number in 24 hours, so the request
# goes out as this template. Leave both unset to use visit_request in English.
REQUEST_TEMPLATE=visit_request
TEMPLATE_LANGUAGE=en

# true sends plain text when Meta refuses the template. Use it only while Meta
# reviews a new template. Leave it unset in production: plain text is lost for a
# quiet approver, and the visitor is still told the request went out.
TEMPLATE_FALLBACK=

# The approved WhatsApp template for the message a staff member gets when a
# guard records their entry. It takes three values: name, time, guard. Unset,
# the message goes as plain text, which arrives only if the staff member wrote
# to this number in the last 24 hours. See docs/setup.md.
STAFF_ENTRY_TEMPLATE=

# Days a visit record is kept. The privacy screen states this number.
RETAIN_DAYS=90

# The Postgres connection string from Neon: Connect, then copy the string.
# Use a separate Neon branch on your own machine, not the live database.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
